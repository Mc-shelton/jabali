# Analytics — copy this file to `.env` (or set these in your host's build env,
# e.g. Vercel Project Settings → Environment Variables) and fill in the IDs.
#
# Vite inlines these at BUILD time, so they must be present wherever
# `npm run build` runs. Leave either blank to disable that tool — with both
# blank, the site tracks nobody and no cookie banner appears.

# Google Analytics 4 — traffic, funnel events, click tracking.
# Find it in GA under Admin → Data streams → your stream → "Measurement ID".
VITE_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity — heatmaps + session replay.
# Find it in Clarity under Settings → Overview → "Clarity project id".
VITE_CLARITY_ID=
