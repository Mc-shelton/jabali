Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let the PHP API and uploaded files be served directly — never rewrite them
  # to the single-page app.
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  # The sitemap is generated live from the current events and merch, so requests
  # for /sitemap.xml are served by sitemap.php. This must come before the asset
  # rule below, which 404s a missing .xml — there is no sitemap.xml file.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # A request that looks like a file but isn't one must 404 rather than fall
  # through to the app. Otherwise a missing asset returns index.html with a 200,
  # and the browser is handed HTML where it expected media: an <audio> element
  # reports "format not supported" and a player sits at 0% forever, with nothing
  # anywhere saying the file is simply absent. This cost real debugging time on
  # the music page.
  RewriteCond %{REQUEST_URI} \.(mp3|m4a|wav|ogg|flac|mp4|webm|mov|jpe?g|png|webp|avif|gif|svg|ico|pdf|css|js|mjs|map|json|txt|xml|woff2?|ttf|eot|zip)$ [NC]
  RewriteRule ^ - [R=404,L]

  # A single event or product is served through preview.php, which returns the
  # same index.html with that item's own poster in the og: tags. Link crawlers
  # (WhatsApp, Facebook, X, Slack) never run JavaScript, so tags set by React
  # are never seen — the HTML has to arrive already carrying them.
  #
  # Only these two shapes. The listing pages (/events, /merch) and every other
  # route stay a plain static file serve with the site-wide defaults.
  RewriteRule ^events/[^/]+/?$ preview.php [L]
  RewriteRule ^merch/[^/]+/?$ preview.php [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Deep links into the single-page app are handled by the rewrite above, so this
# only catches genuine misses. It is deliberately NOT used for the asset rule:
# that returns a bare 404 so the browser sees a missing file, not a page.
ErrorDocument 404 /index.html
